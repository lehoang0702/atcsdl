# Cấu hình hạ tầng Oracle 21c XE - Đề tài 19 (Phần 1)
CONTAINER_NAME=atcsdl-oracle21c
ORACLE_PORT=1521
ORACLE_SID=XE
ORACLE_PDB=XEPDB1

# Mật khẩu quản trị SYS / SYSTEM / PDBADMIN
ORACLE_PASSWORD=OracleAdmin123

# Tài khoản ứng dụng sở hữu bảng STUDENTS và GRADES (dùng cho Web SQLi - KB1)
APP_USER=UNI_APP
APP_USER_PASSWORD=UniApp123

# Tài khoản phục vụ kịch bản Brute-force bằng Hydra (KB2) - không bị khóa sau 10 lần sai
BRUTEFORCE_USER=GV_USER
BRUTEFORCE_PASSWORD=oracle123
